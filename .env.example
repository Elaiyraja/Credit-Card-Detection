PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Payment Gateways (Leave empty or test key to activate graceful mock/sandbox fallback)
STRIPE_SECRET_KEY=sk_test_mock_secret_key_demo12345
STRIPE_WEBHOOK_SECRET=whsec_mock_demo_secret_67890

# Optional Braintree / PayPal sandbox credentials
BRAINTREE_MERCHANT_ID=mock_merchant_id
BRAINTREE_PUBLIC_KEY=mock_public_key
BRAINTREE_PRIVATE_KEY=mock_private_key

# Fraud Engine Configuration
RISK_THRESHOLD_HIGH=75
RISK_THRESHOLD_MEDIUM=45
MAX_HOURLY_VELOCITY_PER_IP=5
MAX_HOURLY_VELOCITY_PER_CARD=3
